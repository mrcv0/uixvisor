{
  "name": "@uixvisor/tokens",
  "version": "0.0.0",
  "description": "Semantic design tokens (foundation/semantic/component/motion/elevation)",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/index.test.js dist/icons.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
