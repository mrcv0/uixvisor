{
  "name": "@uixvisor/presets",
  "version": "0.0.0",
  "description": "Default and Fintech theme presets built on UIXVISOR semantic tokens",
  "keywords": [
    "design-tokens",
    "expo",
    "react-native",
    "theme",
    "preset",
    "fintech"
  ],
  "homepage": "https://github.com/mrcv0/uixvisor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcv0/uixvisor.git",
    "directory": "packages/presets"
  },
  "bugs": {
    "url": "https://github.com/mrcv0/uixvisor/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@uixvisor/tokens": "0.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/index.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
