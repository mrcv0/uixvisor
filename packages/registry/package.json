{
  "name": "@uixvisor/registry",
  "version": "0.0.0",
  "description": "Secure local and hosted registry resolution for UIXVISOR",
  "keywords": [
    "expo",
    "react-native",
    "registry",
    "checksum",
    "offline",
    "security"
  ],
  "homepage": "https://github.com/mrcv0/uixvisor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcv0/uixvisor.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/mrcv0/uixvisor/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "HOSTED.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@uixvisor/registry-schema": "0.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/index.test.js dist/hosted.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
