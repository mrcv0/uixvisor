{
  "name": "@uixvisor/registry-schema",
  "version": "0.0.0",
  "description": "Zod schemas and validation contracts for UIXVISOR registries",
  "keywords": [
    "zod",
    "schema",
    "validation",
    "expo",
    "react-native",
    "registry"
  ],
  "homepage": "https://github.com/mrcv0/uixvisor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcv0/uixvisor.git",
    "directory": "packages/registry-schema"
  },
  "bugs": {
    "url": "https://github.com/mrcv0/uixvisor/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/schema.test.js dist/urls.test.js && node dist/validate-registry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
