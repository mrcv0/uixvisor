{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIXVISOR Registry Item",
  "type": "object",
  "required": [
    "name",
    "type",
    "version",
    "platforms",
    "compatibility",
    "dependencies",
    "registryDependencies",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case unique item name"
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:primitive",
        "registry:component",
        "registry:block",
        "registry:screen",
        "registry:flow"
      ]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["ios", "android", "web"] }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": [
          "expo",
          "nativewind",
          "reanimated",
          "gesture-handler",
          "react-native",
          "react"
        ]
      },
      "patternProperties": {
        "^(expo|nativewind|reanimated|gesture-handler|react-native|react)$": {
          "type": "string",
          "pattern": "^(>=|<=|>|<|~|^)?\\d+(\\.\\d+){0,2}(?:[\\s\\t\\n-]+(>=|<=|>|<|~|^)?\\d+(\\.\\d+){0,2})?$"
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^(?!\\.{0,2}(/|$))([a-z0-9-]+/)*[a-z0-9-]+\\.[a-z]+$"
          },
          "target": {
            "type": "string",
            "pattern": "^(?!\\.{0,2}(/|$))([a-z0-9-]+/)*[a-z0-9-]+\\.[a-z]+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
