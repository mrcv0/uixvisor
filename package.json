{
  "name": "uixvisor-monorepo",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint registry",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "smoke:cli": "npm run build --workspace uixvisor && node scripts/smoke-cli.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:tokens": "npm run build --workspace @uixvisor/tokens && node scripts/verify-tokens.mjs",
    "release": "changeset version && npm run lint && npm run typecheck && npm test && npm run smoke:cli && npm run verify:build && npm run verify:tokens",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@hookform/resolvers": "^5.5.7",
    "@types/node": "^22.13.0",
    "next": "16.2.11",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": "16.2.11",
    "sharp": "0.35.0",
    "postcss": "8.5.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.0",
    "react-native-worklets": "0.10.0"
  }
}
