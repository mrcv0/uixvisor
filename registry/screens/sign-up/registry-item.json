{
  "$schema": "https://uixvisor.dev/schema/registry-item.json",
  "name": "sign-up",
  "type": "registry:screen",
  "version": "0.2.0",
  "title": "Sign Up Screen",
  "description": "Name, email, and password sign-up with shared Zod schema and React Hook Form adapter.",
  "platforms": ["ios", "android", "web"],
  "compatibility": {
    "expo": ">=57 <58",
    "nativewind": ">=4 <5"
  },
  "dependencies": ["react-hook-form", "zod", "@hookform/resolvers"],
  "registryDependencies": [
    "button",
    "form-adapter",
    "auth-schemas",
    "input",
    "text"
  ],
  "files": [
    {
      "source": "sign-up.tsx",
      "target": "components/screens/sign-up.tsx"
    }
  ]
}
