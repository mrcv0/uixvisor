{
  "$schema": "https://uixvisor.dev/schema/registry-item.json",
  "name": "sign-in",
  "type": "registry:screen",
  "version": "0.3.0",
  "title": "Sign In Screen",
  "description": "Validated email + password sign-in: Zod schema, RHF adapter, keyboard-aware layout, focus-first-error.",
  "platforms": ["ios", "android", "web"],
  "compatibility": {
    "expo": ">=57 <58",
    "nativewind": ">=4 <5"
  },
  "dependencies": ["react-hook-form", "zod", "@hookform/resolvers"],
  "registryDependencies": [
    "button",
    "form-adapter",
    "auth-schemas",
    "input",
    "keyboard-aware-form",
    "text"
  ],
  "files": [
    {
      "source": "sign-in.tsx",
      "target": "components/screens/sign-in.tsx"
    }
  ]
}
