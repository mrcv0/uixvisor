{
  "$schema": "https://uixvisor.dev/schema/registry-item.json",
  "name": "sign-in",
  "type": "registry:screen",
  "version": "0.4.0",
  "title": "Sign In Screen",
  "description": "Validated email + password sign-in with optional footer links, social slot, and AppHeader chrome.",
  "platforms": ["ios", "android", "web"],
  "compatibility": {
    "expo": ">=57 <58",
    "nativewind": ">=4 <5"
  },
  "dependencies": ["react-hook-form", "zod", "@hookform/resolvers"],
  "registryDependencies": [
    "app-header",
    "auth-schemas",
    "button",
    "form-adapter",
    "heading",
    "input",
    "keyboard-aware-form",
    "text",
    "theme"
  ],
  "files": [
    {
      "source": "sign-in.tsx",
      "target": "components/screens/sign-in.tsx"
    }
  ]
}
